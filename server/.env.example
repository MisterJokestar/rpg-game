# -------------------------------------------------------
# Server
# -------------------------------------------------------
HOST=0.0.0.0
PORT=5000

# Log level (error | warn | info | debug | trace)
RUST_LOG=server=debug,tower_http=debug

# --- Firestore (default) -----------------------------
# Requires Application Default Credentials or a service
# account key exported as GOOGLE_APPLICATION_CREDENTIALS.
FIRESTORE_PROJECT_ID=your-gcp-project-id

# --- MongoDB (--features mongodb) --------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=yourpassword
MONGO_PORT=27017
# Use localhost when running the server directly, or the service name (mongo) inside containers:
# MONGODB_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@localhost:${MONGO_PORT}
# MONGODB_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017
MONGODB_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@localhost:${MONGO_PORT}
MONGODB_DB_NAME=app_db
