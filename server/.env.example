# -------------------------------------------------------
# Server
# -------------------------------------------------------
HOST=0.0.0.0
PORT=5000

# Log level (error | warn | info | debug | trace)
RUST_LOG=server=debug,tower_http=debug

# -------------------------------------------------------
# Database backend — set to "mongodb" for local dev,
#                   "firestore" for production.
# -------------------------------------------------------
DATABASE_BACKEND=mongodb

# --- MongoDB (local dev) --------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=yourpassword
MONGO_PORT=27017
MONGODB_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@localhost:27017
MONGODB_DB_NAME=app_db

# --- Firestore (production) -----------------------------
# Requires Application Default Credentials or a service
# account key exported as GOOGLE_APPLICATION_CREDENTIALS.
FIRESTORE_PROJECT_ID=your-gcp-project-id
